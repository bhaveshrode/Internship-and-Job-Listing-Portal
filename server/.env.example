# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas free tier or local)
MONGO_URI=mongodb://localhost:27017/job-portal

# Secret for signing admin JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin credentials (used by `npm run seed` only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

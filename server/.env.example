# Server port (hosting platforms usually inject their own PORT)
PORT=5000

# Set to "production" on your hosting platform. Enables fail-fast checks and
# serving the built React frontend from client/dist (single-origin deploy).
# NODE_ENV=production

# CORS: comma-separated list of allowed frontend origins. REQUIRED in production
# when the frontend is hosted on a different domain than this API; unset in
# development to allow all origins.
# CORS_ORIGIN=https://your-frontend.example.com

# MongoDB connection string (MongoDB Atlas free tier or local)
MONGO_URI=mongodb://localhost:27017/job-portal

# Secret for signing admin JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin credentials (used by `npm run seed` only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API base URL baked into the build at build time.
# Default: /api (same-origin) — works with the Vite dev proxy and when the
# Express server serves the built frontend.
# For a split deployment (frontend and backend on different hosts), set the
# full backend URL before building, e.g.:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api
